{
  "name": "dsh-obsidian-memory",
  "version": "0.2.0",
  "description": "Long-term memory for DeepSeek Harness stored as Obsidian notes: global facts plus per-project notes, written through the Obsidian CLI.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/cli.js",
    "lib/vault.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "obsidian",
    "memory",
    "long-term-memory",
    "agent-memory"
  ],
  "author": "Goutam Kumar Sharma <goutamkumar.sharmq@gmail.com> (https://github.com/Goutam-11)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goutam-11/dsh-obsidian-memory.git"
  },
  "homepage": "https://github.com/Goutam-11/dsh-obsidian-memory#readme",
  "bugs": {
    "url": "https://github.com/Goutam-11/dsh-obsidian-memory/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/vault.test.mjs && node test/plugin.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
